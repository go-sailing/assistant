# 服务端口
PORT=3000

# PostgreSQL 连接（对应 src/docker-compose.yml 中的容器）
DATABASE_URL=postgres://assistant:assistant_pwd@localhost:5432/assistant
# 启动时自动执行数据库迁移
DB_AUTO_MIGRATE=true

# JWT
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=2h

# DeepSeek（必填，缺失则对话功能不可用）
# 模型名以 DeepSeek 官方 /models 接口返回为准：deepseek-flash / deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRY=2

# 对话上下文保留的最近消息条数
CHAT_HISTORY_LIMIT=20

# 待确认动作有效期（秒）
PENDING_ACTION_TTL_SECONDS=300

# 限流：登录/注册（次/分钟/IP），对话（次/分钟/用户）
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=20