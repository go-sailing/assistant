# 服务端口
PORT=3000

# PostgreSQL 连接（对应 src/docker-compose.yml 中的容器）
DATABASE_URL=postgres://assistant:assistant_pwd@localhost:5432/assistant
# 启动时自动执行数据库迁移
DB_AUTO_MIGRATE=true

# JWT
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=2h
# v0.4.0：时钟容忍（秒），消除服务/客户端偏差导致的伪 401
ACCESS_CLOCK_TOLERANCE_SEC=30

# 登录态续期（v0.4.0）
# refresh 令牌有效期（天，滑动：每次使用轮转续期）
REFRESH_TOKEN_TTL_DAYS=30
# /auth/refresh 限流（次/分钟/IP）
RATE_LIMIT_REFRESH_PER_MIN=10

# DeepSeek（必填，缺失则对话功能不可用）
# 模型名以 DeepSeek 官方 /models 接口返回为准：deepseek-flash / deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRY=2

# 对话上下文保留的最近消息条数
CHAT_HISTORY_LIMIT=20

# 待确认动作有效期（秒）
PENDING_ACTION_TTL_SECONDS=300

# 限流：登录/注册（次/分钟/IP），对话（次/分钟/用户）
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=20

# 日程领域（v0.1.0）
# 客户端未上传 IANA 时区时的兜底时区，影响「今天/明天」的自然日边界与月视图归日
EVENT_DEFAULT_TZ=Asia/Shanghai
# 仅给开始时间时的默认时长（分钟）
EVENT_DEFAULT_DURATION_MIN=60
# 冲突检测返回条数上限
EVENT_CONFLICT_SCAN_LIMIT=50
# 日程列表/批量预取条数上限
EVENT_LIST_MAX_LIMIT=200

# 循环日程（v0.2.0）
# 创建/整条改期的循环冲突扫描窗口（天）
EVENT_RECURRENCE_CONFLICT_WINDOW_DAYS=90
# 重复次数上限，同时是单次展开的种子上限
EVENT_SERIES_MAX_COUNT=730
# 截止日期距首次实例的最大年限
EVENT_SERIES_MAX_UNTIL_YEARS=5
# 重复间隔上限
EVENT_RECUR_INTERVAL_MAX=99
# 系列详情实例分页大小
EVENT_OCCURRENCE_PAGE_SIZE=20

# 子任务（v0.2.0）
# 子任务最大层级（根任务为第 1 级）
TASK_MAX_DEPTH=5
# 子树查询节点数上限
TASK_TREE_MAX_NODES=200

# 法定工作日历（v0.4.0）
# 国家/地区（当前仅支持 CN，数据见迁移 007/后续年度追加迁移）
WORK_CALENDAR_COUNTRY=CN
# 上下文自动压缩（v0.5.0，PRD 4.x）
# 模型上下文窗口（token）：替换模型时只需改这里
CHAT_MODEL_CONTEXT_TOKENS=64000
# 压缩触发水位（占窗口比例）
CHAT_COMPACT_THRESHOLD_RATIO=0.8
# 最近保留原文的消息条数
CHAT_RECENT_KEEP=10
# 连续压缩时保留窗下限（未决交互的原文保护优先于此值）
CHAT_COMPACT_MIN_KEEP=6
# 单份滚动摘要的 token 上限
CHAT_SUMMARY_MAX_TOKENS=1000

# 长期记忆（v0.5.0，PRD 5.x）
# 单次归档提炼的候选条数上限
MEMORY_ARCHIVE_BATCH_LIMIT=30
# 每用户记忆总条数上限（超出按语义合并 / 淘汰最旧）
MEMORY_MAX_TOTAL=100
# 记忆注入上下文的 token 预算
MEMORY_INJECT_TOKEN_BUDGET=800
# 单次归档参与提取的最近消息条数上限
MEMORY_ARCHIVE_MAX_MESSAGES=400
# 记忆注入装配的进程内缓存 TTL（毫秒）
MEMORY_INJECT_CACHE_TTL_MS=60000

# 归档限流（次/分钟/用户）
RATE_LIMIT_ARCHIVE_PER_MIN=1

# 智能体代理（v0.7.0，PRD 4.x / 系统设计文档 16.3）
# 单用户代理数上限
AGENT_MAX_PER_USER=20
# 单代理待执行队列上限（指派/重试时校验）
AGENT_QUEUE_MAX=100
# 代理"在线"判定窗口（分钟；最近活跃超出即视为离线）
AGENT_ACTIVE_WINDOW_MIN=5
# wait_agent_task 长轮询服务端硬上限（毫秒，客户端请求值会被夹取到该上限）
AGENT_WAIT_TIMEOUT_MS=25000
# 长轮询兜底轮询间隔（毫秒，覆盖多实例与事件丢失）
AGENT_WAIT_FALLBACK_POLL_MS=2000
# 长轮询并发等待者上限（超出立即返回空，由客户端重试）
AGENT_WAIT_MAX_CONCURRENCY=200
# 每个任务的执行记录保留条数（写入时裁剪）
AGENT_LOG_KEEP=50
# 代理绑定任务列表默认分页大小
AGENT_QUEUE_PAGE_SIZE=20
# MCP 接入端点限流（次/分钟/代理凭据）
RATE_LIMIT_MCP_PER_MIN=60
