# 个人助手前端 nginx 配置模板（容器启动时由 envsubst 渲染）
# 变量：${API_UPSTREAM}（后端地址，含协议）、${API_PROXY_TIMEOUT}（SSE/长请求超时秒数）

server {
    listen       80;
    listen       [::]:80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # 前端为 SPA：未命中的路径回落到 index.html（支持刷新/直达子路由）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html 不缓存（`expires -1` 即 Cache-Control: no-cache），保证发版后立即拿到新指纹；
    # 注意：location 内一旦写 add_header 就不再继承 server 级响应头，故缓存统一用 expires 表达
    location = /index.html {
        expires -1;
    }

    # Vite 产物带内容指纹，可长期强缓存（max-age=31536000）
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # 同源反向代理后端（H5 与 API 同源，无需处理跨域）
    location /api/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        # 对话为 SSE 流式响应：关闭缓冲并放宽读超时，否则前端会“卡住不吐字”
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout ${API_PROXY_TIMEOUT}s;
        proxy_send_timeout ${API_PROXY_TIMEOUT}s;
    }

    # 容器/编排健康检查直通后端（含数据库探测）
    location = /healthz {
        proxy_pass       ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_comp_level   6;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/manifest+json;

    # 基础安全响应头
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
}